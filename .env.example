# ========================================================
# SmartLink AI - Environment Configuration (.env.example)
# ========================================================
# Copy this file to .env and configure for your local environment:
#   cp .env.example .env
#
# NOTE: All secrets in this file are placeholders. Do NOT commit real secrets.

# --------------------------------------------------------
# Server & Network Configuration
# --------------------------------------------------------
# Port for the Express full-stack dev server (Vite middleware mounted)
PORT=3000
# Optional port for running the Express API in standalone mode (npm run dev:api)
API_PORT=4000
# Environment mode: 'development', 'test', or 'production'
NODE_ENV=development
# API path prefix (default: /api)
API_PREFIX=/api
# Public base URL used for canonical short links and redirects
APP_URL=http://localhost:3000
# Client-side API target URL (empty string defaults to same-origin in dev)
VITE_API_BASE_URL=http://localhost:3000

# --------------------------------------------------------
# Supabase PostgreSQL & Auth Configuration
# --------------------------------------------------------
# Supabase Project URL (required for live Supabase Auth and database access)
SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key:
# Safe to expose in the frontend browser client for authentication.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_anon_key
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_anon_key

# Supabase Service Role Secret Key (SERVER-SIDE ONLY):
# NEVER expose this key in client-side code or public repositories.
# Used exclusively by the Express backend for administrative tasks and bypass RLS where authorized.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_service_role_key

# Supabase JWT Secret (SERVER-SIDE ONLY):
# Used by the backend to verify Bearer access tokens from the Authorization header.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-token-verification

# Direct PostgreSQL Connection String (SERVER-SIDE ONLY):
# Used by migration tools or backend ORM if direct database connection is needed.
DATABASE_URL=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres

# --------------------------------------------------------
# Rate Limiting & Security (SERVER-SIDE ONLY)
# --------------------------------------------------------
# Global request window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Global maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100
# Per-user link creation rate limit (default: 10 links per 60 seconds)
RATE_LIMIT_LINK_CREATION_MAX=10
